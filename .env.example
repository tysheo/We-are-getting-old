# Copy to .env and fill in. Only the keys you set are used; the harvester skips
# any source whose key is missing, so you can start with just the keyless ones
# (The Met, Wikimedia Commons, Poly Haven, ambientCG all need NO key).

# Stock photo APIs
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Museum / archive APIs
SMITHSONIAN_API_KEY=     # https://api.data.gov/signup/
EUROPEANA_API_KEY=       # https://pro.europeana.eu/page/get-api
RIJKSMUSEUM_API_KEY=     # https://data.rijksmuseum.nl/

# How many images to keep per theme per source (keep small while testing)
PER_THEME=12
